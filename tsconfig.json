{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "exactOptionalPropertyTypes": false
  },
  "include": ["server/src/**/*.ts", "server/tests/**/*.ts", "scripts/**/*.mjs"]
}
