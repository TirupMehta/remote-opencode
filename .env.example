# OpenCode Remote — non-secret configuration template.
# Copy to .env to override defaults. Never put passwords here for daily use;
# prefer the first-run setup screen (loopback only) or the OS keychain-managed
# OCR_PASSWORD env var on the laptop.
#
# Port for the remote UI + API (laptop side).
OCR_PORT=8787
# Bind address. Keep 127.0.0.1 (default). For phone access over Tailscale,
# set to the Tailscale IPv4 (100.x.y.z) — see README. Never 0.0.0.0 unless
# you understand the exposure.
OCR_HOST=127.0.0.1
# Directory for config.json + secrets (defaults to %APPDATA%/opencode-remote).
# OCR_DATA_DIR=
# Initial password (only used when no password is set yet).
# OCR_PASSWORD=
# Extra CORS origins for the API (opencode serve gets none; this is ours).
# OCR_CORS_ORIGINS=
# Allowlisted project directories, comma-separated (also editable in Settings).
# OCR_PROJECTS=
# Path to the opencode executable (auto-detected if unset).
# OPENCODE_BIN=
