{
  "name": "opencode-remote",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Private mobile-first remote control for the OpenCode CLI. No cloud, no external AI API, no extra runtime dependencies.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/src/main.ts",
    "check": "tsc -p tsconfig.json",
    "test": "node --test \"server/tests/*.test.ts\"",
    "test:integration": "node --test \"server/tests/integration.test.ts\"",
    "setup:web": "node scripts/setup-web.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@xterm/xterm": "^5.5.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0"
  }
}
